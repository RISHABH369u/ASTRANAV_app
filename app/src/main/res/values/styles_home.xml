<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeChipCell">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_row_default</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
    </style>

    <style name="HomeChipLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fg_faint</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeChipValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeTripStatCell">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
    </style>

    <style name="HomeTripIconBg">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_icon_square</item>
    </style>

    <style name="HomeTripIcon">
        <item name="android:layout_width">17dp</item>
        <item name="android:layout_height">17dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="tint">@color/cyan</item>
    </style>

    <style name="HomeTripLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fg_faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
