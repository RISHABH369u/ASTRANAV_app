<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AstraText" parent="android:style/TextAppearance.Material">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="AstraLabel">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/fg_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text" parent="AstraText" />

    <style name="Text.Label" parent="AstraLabel" />

    <style name="Text.Title">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Text.Body">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/fg_dim</item>
    </style>

    <style name="Theme.AstraNav" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink_900</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>
</resources>
