<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AstraText" parent="android:style/TextAppearance.Material">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="AstraLabel">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/fg_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text" parent="AstraText" />

    <style name="Text.Label" parent="AstraLabel" />

    <style name="Text.Title">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Text.Body">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/fg_dim</item>
    </style>

    <style name="Theme.AstraNav" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink_900</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>


        <style name="DvfcTelemetryCell">
            <item name="android:orientation">vertical</item>
            <item name="android:background">@drawable/bg_card</item>
            <item name="android:padding">12dp</item>
            <item name="android:layout_width">0dp</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_columnWeight">1</item>
        </style>

        <style name="DvfcTelemetryLabel">
            <item name="android:layout_width">wrap_content</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:textColor">@color/fg_faint</item>
            <item name="android:textSize">10sp</item>
            <item name="android:letterSpacing">0.08</item>
            <item name="android:textStyle">bold</item>
        </style>

        <style name="DvfcTelemetryValue">
            <item name="android:layout_width">wrap_content</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_marginTop">4dp</item>
            <item name="android:fontFamily">monospace</item>
            <item name="android:textSize">20sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:text">--</item>
        </style>

</resources>
