<?xml version="1.0" encoding="utf-8"?>

<!-- Root is a plain vertical LinearLayout: the checklist scrolls in the
     NestedScrollView below, but the action buttons live in a sibling bar
     pinned to the bottom of the screen so they're always reachable, no
     matter how far the person has scrolled into the evidence list. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ink_900"

    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"

        android:clipToPadding="false"

        android:fillViewport="true">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">


            <!-- HEADER -->

            <TextView
                style="@style/DvfcQualityKicker"
                android:text="ASTRA NAV · DVFC" />

            <TextView
                style="@style/DvfcQualityTitle"
                android:text="Vehicle Frame Quality" />

            <TextView
                style="@style/DvfcQualitySubtitle"
                android:text="Validate sensor preparation, calibration evidence and the final Device → Vehicle transform before navigation." />


            <!-- ================================================= -->
            <!-- 01 OVERALL QUALITY — hero card -->
            <!-- ================================================= -->

            <LinearLayout
                style="@style/DvfcHeroCard"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Ring gauge with the score printed in its center -->
                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp">

                    <com.rishabh.astranav.ui.view.CircularGaugeView
                        android:id="@+id/dvfcQualityGauge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/dvfcQualityScore"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="monospace"

                            android:text="—"

                            android:textColor="@color/fg"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:letterSpacing="0.1"
                            android:text="SCORE"
                            android:textColor="@color/fg_faint"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DvfcSectionLabel"
                        android:text="OVERALL VEHICLE FRAME QUALITY" />

                    <TextView
                        android:id="@+id/dvfcQualityStatus"
                        style="@style/DvfcStatusChip"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"

                        android:background="@drawable/bg_dvfc_status_chip_waiting"
                        android:text="WAITING FOR TELEMETRY"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/dvfcQualityHint"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"

                        android:text="Collecting evidence from the sensor adapter and calibration pipeline."
                        android:textColor="@color/fg_dim"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 02 SENSOR ADAPTER -->
            <!-- ================================================= -->

            <LinearLayout style="@style/DvfcSectionHeaderRow">

                <View
                    android:id="@+id/sectionDotAdapter"
                    style="@style/DvfcSectionDot" />

                <TextView
                    style="@style/DvfcQualitySectionTitleText"
                    android:text="02  SENSOR ADAPTER" />

            </LinearLayout>


            <LinearLayout

                style="@style/DvfcQualityCard"

                android:orientation="vertical">


                <TextView

                    style="@style/DvfcMiniTitle"

                    android:text="RAW SENSOR STREAM → NORMALIZED STREAM" />


                <!-- PIPELINE -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:gravity="center_vertical">


                    <LinearLayout
                        style="@style/DvfcPipelineNode">

                        <TextView
                            style="@style/DvfcPipelineNodeTitle"
                            android:text="TIMESTAMP" />

                        <TextView
                            style="@style/DvfcPipelineNodeDetail"
                            android:text="sensor clocks" />

                    </LinearLayout>


                    <TextView
                        style="@style/DvfcPipelineArrow"
                        android:text="→" />


                    <LinearLayout
                        style="@style/DvfcPipelineNode">

                        <TextView
                            style="@style/DvfcPipelineNodeTitle"
                            android:text="SYNC" />

                        <TextView
                            style="@style/DvfcPipelineNodeDetail"
                            android:text="aligned time" />

                    </LinearLayout>


                    <TextView
                        style="@style/DvfcPipelineArrow"
                        android:text="→" />


                    <LinearLayout
                        style="@style/DvfcPipelineNode">

                        <TextView
                            style="@style/DvfcPipelineNodeTitle"
                            android:text="UNITS" />

                        <TextView
                            style="@style/DvfcPipelineNodeDetail"
                            android:text="SI normalized" />

                    </LinearLayout>

                </LinearLayout>


                <View style="@style/DvfcDivider" />


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Timestamp Synchronization" />

                    <TextView
                        android:id="@+id/adapterTimeSync"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Unit Normalization" />

                    <TextView
                        android:id="@+id/adapterUnits"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Data Gaps" />

                    <TextView
                        android:id="@+id/adapterGaps"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Resampling" />

                    <TextView
                        android:id="@+id/adapterResampling"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Gravity Compensation" />

                    <TextView
                        android:id="@+id/adapterGravity"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 03 CALIBRATION -->
            <!-- ================================================= -->

            <LinearLayout style="@style/DvfcSectionHeaderRow">

                <View
                    android:id="@+id/sectionDotCalibration"
                    style="@style/DvfcSectionDot" />

                <TextView
                    style="@style/DvfcQualitySectionTitleText"
                    android:text="03  CALIBRATION QUALITY" />

            </LinearLayout>


            <LinearLayout
                style="@style/DvfcQualityCard"
                android:orientation="vertical">


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Manual Alignment" />

                    <TextView
                        android:id="@+id/scoreManual"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Gravity Leveling" />

                    <TextView
                        android:id="@+id/scoreGravity"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Gyro Bias Estimation" />

                    <TextView
                        android:id="@+id/scoreGyro"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Mount Azimuth" />

                    <TextView
                        android:id="@+id/scoreAzimuth"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Automatic Refinement" />

                    <TextView
                        android:id="@+id/scoreRefinement"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Mount Stability" />

                    <TextView
                        android:id="@+id/scoreMount"
                        style="@style/DvfcStatusChip"
                        android:text="WAITING" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 04 GNSS -->
            <!-- ================================================= -->

            <LinearLayout style="@style/DvfcSectionHeaderRow">

                <View style="@style/DvfcSectionDot"
                    android:background="@drawable/bg_dvfc_section_dot_pass"
                    android:alpha="0.55" />

                <TextView
                    style="@style/DvfcQualitySectionTitleText"
                    android:text="04  GNSS QUALITY" />

            </LinearLayout>


            <LinearLayout
                style="@style/DvfcQualityCard"
                android:orientation="horizontal">


                <LinearLayout
                    style="@style/DvfcMetricBlock">

                    <TextView
                        style="@style/DvfcMetricCaption"
                        android:text="ACCURACY" />

                    <TextView
                        android:id="@+id/gnssAccuracy"
                        style="@style/DvfcMetricBig"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout
                    style="@style/DvfcMetricBlock">

                    <TextView
                        style="@style/DvfcMetricCaption"
                        android:text="SPEED" />

                    <TextView
                        android:id="@+id/gnssSpeed"
                        style="@style/DvfcMetricBig"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout
                    style="@style/DvfcMetricBlock">

                    <TextView
                        style="@style/DvfcMetricCaption"
                        android:text="VALID SAMPLES" />

                    <TextView
                        android:id="@+id/gnssSamples"
                        style="@style/DvfcMetricBig"
                        android:text="—" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 05 EXCITATION -->
            <!-- ================================================= -->

            <TextView
                style="@style/DvfcQualitySectionTitle"
                android:text="05  ACCELERATION EXCITATION" />


            <LinearLayout
                style="@style/DvfcQualityCard"
                android:orientation="vertical">


                <TextView
                    style="@style/DvfcMiniTitle"
                    android:text="FORWARD-MOTION EVIDENCE" />


                <TextView

                    android:id="@+id/excitationValue"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:fontFamily="monospace"

                    android:text="—"

                    android:textColor="@color/cyan"
                    android:textSize="28sp"
                    android:textStyle="bold" />


                <TextView

                    style="@style/DvfcMetricCaption"

                    android:text="EXCITATION SCORE" />


                <TextView

                    android:id="@+id/excitationSamples"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Usable samples: —"

                    android:textColor="@color/fg_dim"
                    android:textSize="12sp" />

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 06 AZIMUTH -->
            <!-- ================================================= -->

            <TextView
                style="@style/DvfcQualitySectionTitle"
                android:text="06  MOUNT AZIMUTH CONVERGENCE" />


            <LinearLayout
                style="@style/DvfcQualityCard"
                android:orientation="vertical">


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Manual Estimate" />

                    <TextView
                        android:id="@+id/azimuthManual"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Automatic Estimate" />

                    <TextView
                        android:id="@+id/azimuthAutomatic"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Residual" />

                    <TextView
                        android:id="@+id/azimuthResidual"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Circular Consistency" />

                    <TextView
                        android:id="@+id/azimuthConsistency"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="Valid Samples" />

                    <TextView
                        android:id="@+id/azimuthSamples"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 07 STABILITY -->
            <!-- ================================================= -->

            <TextView
                style="@style/DvfcQualitySectionTitle"
                android:text="07  STABILITY MONITORS" />


            <LinearLayout

                style="@style/DvfcQualityCard"

                android:orientation="horizontal">


                <LinearLayout
                    style="@style/DvfcMetricBlock">

                    <TextView
                        style="@style/DvfcMetricCaption"
                        android:text="STATIONARY" />

                    <TextView
                        android:id="@+id/stationaryScore"
                        style="@style/DvfcMetricBig"
                        android:text="—" />

                    <TextView
                        android:id="@+id/stationarySamples"
                        style="@style/DvfcMetricCaption"
                        android:text="samples: —" />

                </LinearLayout>


                <LinearLayout
                    style="@style/DvfcMetricBlock">

                    <TextView
                        style="@style/DvfcMetricCaption"
                        android:text="GRAVITY" />

                    <TextView
                        android:id="@+id/gravityScore"
                        style="@style/DvfcMetricBig"
                        android:text="—" />

                </LinearLayout>

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 09 MOUNT CHANGE — tinted status banner -->
            <!-- ================================================= -->

            <TextView
                style="@style/DvfcQualitySectionTitle"
                android:text="09  MOUNT-CHANGE STATUS" />


            <LinearLayout

                android:id="@+id/mountBanner"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@drawable/bg_dvfc_mount_banner_waiting"

                android:orientation="vertical"
                android:padding="15dp">


                <TextView

                    android:id="@+id/mountStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="WAITING"

                    android:textColor="@color/warn"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Persistent orientation change should trigger recalibration before navigation."

                    android:textColor="@color/fg_dim"
                    android:textSize="11.5sp" />

            </LinearLayout>



            <!-- ================================================= -->
            <!-- 10 FINAL TRANSFORM -->
            <!-- ================================================= -->

            <TextView

                style="@style/DvfcQualitySectionTitle"

                android:text="10  FINE-TUNED DEVICE → VEHICLE TRANSFORM" />


            <LinearLayout

                style="@style/DvfcQualityCard"

                android:orientation="vertical">


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="YAW" />

                    <TextView
                        android:id="@+id/finalYaw"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="PITCH" />

                    <TextView
                        android:id="@+id/finalPitch"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <LinearLayout style="@style/DvfcMetricRow">

                    <TextView
                        style="@style/DvfcMetricName"
                        android:text="ROLL" />

                    <TextView
                        android:id="@+id/finalRoll"
                        style="@style/DvfcMetricValue"
                        android:text="—" />

                </LinearLayout>


                <View style="@style/DvfcDivider" />


                <TextView

                    style="@style/DvfcMetricCaption"

                    android:text="GYRO BIAS · X / Y / Z" />


                <TextView

                    android:id="@+id/finalBias"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:fontFamily="monospace"

                    android:text="—"

                    android:textColor="@color/fg"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================================================= -->
    <!-- PINNED ACTION BAR — always visible, never requires scrolling -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline_soft" />

    <LinearLayout style="@style/DvfcActionBar">

        <Button

            android:id="@+id/actionRecalibrate"

            style="@style/Widget.AppCompat.Button.Borderless"

            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"

            android:background="@drawable/bg_dvfc_quality_secondary"

            android:text="RECALIBRATE"

            android:textAllCaps="false"

            android:textColor="@color/fg"

            android:textSize="13sp"
            android:textStyle="bold" />


        <Button

            android:id="@+id/actionUseCalibration"

            style="@style/Widget.AppCompat.Button.Borderless"

            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.4"
            android:layout_marginStart="10dp"

            android:background="@drawable/bg_dvfc_quality_primary"

            android:enabled="false"

            android:text="USE CALIBRATION"

            android:textAllCaps="false"

            android:textColor="@color/button_primary_text"

            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
