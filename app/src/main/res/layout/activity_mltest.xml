<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_900">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ML TEST LAB"
                android:textColor="@color/fg"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE ON-DEVICE INFERENCE"
                android:textColor="@color/fg_faint"
                android:textSize="9sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMlSystemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LOADING"
            android:textColor="@color/warn"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- LIVE SENSOR CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="15dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LIVE SENSOR INPUT"
                        android:textColor="@color/fg_faint"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvMlSensorStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● WAITING"
                        android:textColor="@color/good"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvMlAccel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="X --   Y --   Z -- m/s²"
                    android:textColor="@color/fg"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMlGravity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="X --   Y --   Z -- m/s²"
                    android:textColor="@color/fg_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMlGyro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="X --   Y --   Z -- rad/s"
                    android:textColor="@color/fg_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMlRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="GYRO |MAG| --"
                    android:textColor="@color/cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMlDvfcStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="DVFC: NOT CALIBRATED"
                    android:textColor="@color/warn"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ASTRA SPEED -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ASTRA-SPEED · GRU"
                android:textColor="@color/cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WINDOW"
                        android:textColor="@color/fg_faint"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvSpeedWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 20"
                        android:textColor="@color/fg"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="RAW MODEL OUTPUT"
                    android:textColor="@color/fg_faint"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSpeedRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Waiting for 20 samples..."
                    android:textColor="@color/fg"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SPEED"
                            android:textColor="@color/fg_faint"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvSpeedKmh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="-- km/h"
                            android:textColor="@color/fg"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VELOCITY"
                            android:textColor="@color/fg_faint"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvSpeedMps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="-- m/s"
                            android:textColor="@color/cyan"
                            android:textSize="18sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LATENCY"
                            android:textColor="@color/fg_faint"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvSpeedLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="-- ms"
                            android:textColor="@color/good"
                            android:textSize="18sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPriorSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0.00 km/h"
                    android:textColor="@color/fg_faint"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>


            <!-- ASTRA MOTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ASTRA-MOTION · V7 SUPREME"
                android:textColor="@color/cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WINDOW"
                        android:textColor="@color/fg_faint"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvMotionWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 10"
                        android:textColor="@color/fg"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="RAW ONNX TENSORS"
                    android:textColor="@color/fg_faint"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvMotionRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Waiting for 10 samples..."
                    android:textColor="@color/fg"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DECODED / PROCESSED"
                    android:textColor="@color/fg_faint"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvMotionProcessed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvMotionLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="-- ms"
                    android:textColor="@color/good"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- ASTRA SPHM -->
            <!-- ========================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="ASTRA-SPHM · STATE-CONDITIONED HEADING"
                android:textColor="@color/cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <!-- WINDOW -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WINDOW"
                        android:textColor="@color/fg_faint"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvSphmWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 20"
                        android:textColor="@color/fg"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <!-- RAW -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="RAW / MODEL OUTPUT"
                    android:textColor="@color/fg_faint"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSphmRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Waiting for 20 samples..."
                    android:textColor="@color/fg"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <!-- PROCESSED -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DECODED / PROCESSED"
                    android:textColor="@color/fg_faint"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSphmProcessed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <!-- LATENCY -->

                <TextView
                    android:id="@+id/tvSphmLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="-- ms"
                    android:textColor="@color/good"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- CONTROLS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnResetMl"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="RESET WINDOWS" />

                <Button
                    android:id="@+id/btnCloseMl"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="CLOSE" />

            </LinearLayout>

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</LinearLayout>

