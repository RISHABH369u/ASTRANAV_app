<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:clipChildren="false">

    <!-- Deep ambient glow, largest, softest -->
    <View
        android:id="@+id/centerGlowOuter"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_glow_outer"
        android:alpha="0" />

    <!-- Tighter core glow directly behind the logo -->
    <View
        android:id="@+id/centerGlow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_glow"
        android:alpha="0" />

    <!-- Radar sweep, sits between the two rings, rotates fastest -->
    <View
        android:id="@+id/radarSweep"
        android:layout_width="282dp"
        android:layout_height="282dp"
        android:layout_gravity="center"
        android:background="@drawable/radar_sweep"
        android:alpha="0" />

    <!-- Outer navigation ring, gradient sweep stroke -->
    <View
        android:id="@+id/ringOuter"
        android:layout_width="310dp"
        android:layout_height="310dp"
        android:layout_gravity="center"
        android:background="@drawable/ring_outer"
        android:alpha="0" />

    <!-- Inner navigation ring, fine dashed stroke -->
    <View
        android:id="@+id/ringInner"
        android:layout_width="255dp"
        android:layout_height="255dp"
        android:layout_gravity="center"
        android:background="@drawable/ring_inner"
        android:alpha="0" />

    <!-- Orbiting navigation point, travels around the outer ring -->
    <FrameLayout
        android:id="@+id/orbitPivot"
        android:layout_width="310dp"
        android:layout_height="310dp"
        android:layout_gravity="center"
        android:clipChildren="false">

        <View
            android:id="@+id/navigationPoint"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-4dp"
            android:background="@drawable/navigation_point"
            android:alpha="0" />

    </FrameLayout>

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- ASTRANAV logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:adjustViewBounds="true"
            android:contentDescription="ASTRANAV"
            android:scaleType="fitCenter"
            android:src="@drawable/astranav_logo"
            android:alpha="0" />

        <!-- Brand name -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.34"
            android:text="ASTRANAV"
            android:textColor="@color/astra_text_primary"
            android:textSize="27sp"
            android:textStyle="normal"
            android:alpha="0" />

        <!-- Thin accent rule that grows under the wordmark -->
        <View
            android:id="@+id/nameUnderline"
            android:layout_width="1dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/astra_accent"
            android:alpha="0" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.28"
            android:text="FIND YOUR WAY"
            android:textColor="@color/astra_text_tertiary"
            android:textSize="9sp"
            android:alpha="0" />

    </LinearLayout>

    <!-- Loading section -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:alpha="0">

        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/splash_progress" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="CALIBRATING NAVIGATION"
            android:textColor="@color/astra_text_tertiary"
            android:textSize="8sp" />

    </LinearLayout>

</FrameLayout>