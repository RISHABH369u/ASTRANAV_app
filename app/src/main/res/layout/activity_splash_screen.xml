<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ink_900"
    android:clipChildren="false">

    <!-- Ambient trajectory backdrop, equivalent of the absolute-inset SVG at opacity-[0.14] -->
    <ImageView
        android:id="@+id/trajectoryBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.14"
        android:scaleType="fitXY"
        android:src="@drawable/trajectory_path"
        android:contentDescription="@null" />

    <!-- Wordmark block, vertically + horizontally centered -->
    <LinearLayout
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:alpha="0">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:scaleType="fitCenter"
            android:src="@drawable/astranav_logo"
            android:contentDescription="ASTRA NAV" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/sorasold"
            android:letterSpacing="0.22"
            android:text="ASTRA NAV"
            android:textColor="@color/color_fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:text="RESILIENT EDGE NAVIGATION"
            android:textColor="@color/color_cyan"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom readout: loading bar + caption -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:alpha="0">

        <FrameLayout
            android:id="@+id/loadingTrack"
            android:layout_width="96dp"
            android:layout_height="3dp"
            android:background="@drawable/round_track_bg"
            android:clipToOutline="true"
            android:clipChildren="true">

            <View
                android:id="@+id/loadingFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_cyan"
                android:scaleX="0"
                android:transformPivotX="0dp" />

        </FrameLayout>

        <TextView
            android:id="@+id/caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16"
            android:text="HYBRID INERTIAL NAVIGATION"
            android:textAllCaps="true"
            android:textColor="@color/color_fg_faint"
            android:textSize="10.5sp" />

    </LinearLayout>

</FrameLayout>