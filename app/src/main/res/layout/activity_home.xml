<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Header: brand + info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:src="@drawable/astranav_logo"
                app2:tint="@color/cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="ASTRA NAV"
                    android:textColor="@color/fg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="RESILIENT EDGE NAVIGATION"
                    android:textColor="@color/fg_faint"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnInfo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_square"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    app2:tint="@color/fg_dim" />
            </FrameLayout>
        </LinearLayout>

        <!-- Nav system status card -->
        <LinearLayout
            android:id="@+id/systemStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="NAVIGATION SYSTEM"
                        android:textColor="@color/fg_faint"
                        android:textSize="10.5sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/systemStatusDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/dot_good" />

                        <TextView
                            android:id="@+id/systemStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:text="READY"
                            android:textColor="@color/good"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app2:tint="@color/fg_faint" />
            </LinearLayout>

            <!-- Live indicator chips: GNSS / IMU / AI / DVFC -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:columnCount="4">

                <LinearLayout
                    style="@style/HomeChipCell"
                    android:layout_column="0"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/chipGnssDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/dot_good" />

                        <TextView
                            style="@style/HomeChipLabel"
                            android:text="GNSS" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chipGnssValue"
                        style="@style/HomeChipValue"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeChipCell"
                    android:layout_column="1"
                    android:layout_marginHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/chipImuDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/dot_good" />

                        <TextView
                            style="@style/HomeChipLabel"
                            android:text="IMU" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chipImuValue"
                        style="@style/HomeChipValue"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeChipCell"
                    android:layout_column="2"
                    android:layout_marginHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/chipAiDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/dot_warn" />

                        <TextView
                            style="@style/HomeChipLabel"
                            android:text="AI" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chipAiValue"
                        style="@style/HomeChipValue"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeChipCell"
                    android:layout_column="3"
                    android:layout_marginStart="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/chipDvfcDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/dot_warn" />

                        <TextView
                            style="@style/HomeChipLabel"
                            android:text="DVFC" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chipDvfcValue"
                        style="@style/HomeChipValue"
                        android:text="--" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <!-- Hero card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-30dp"
                android:background="@drawable/bg_hero_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Ready to Navigate"
                    android:textColor="@color/fg"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <!-- Speed + AI speed + heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/speedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="0"
                                android:textColor="@color/fg"
                                android:textSize="40sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="6dp"
                                android:text="km/h"
                                android:textColor="@color/fg_dim"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/aiSpeedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="AI speed unavailable"
                            android:textColor="@color/fg_faint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="46dp"
                        android:background="@color/hairline_soft" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/headingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="N · 000°"
                            android:textColor="@color/cyan"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/motionValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Stationary"
                            android:textColor="@color/fg_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ZUPT / ZARU indicator pills -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/zuptPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_summary_default"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <View
                            android:id="@+id/zuptDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/dot_warn" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ZUPT"
                            android:textColor="@color/fg_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/zaruPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_summary_default"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <View
                            android:id="@+id/zaruDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/dot_warn" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ZARU"
                            android:textColor="@color/fg_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnStartNav"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_primary_button"
                        android:drawableStart="@drawable/ic_navigate"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="Start Navigation"
                        android:textAllCaps="false"
                        android:textColor="@color/button_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnViewSystem"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_secondary_button"
                        android:drawableStart="@drawable/ic_sensor_default"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="View System"
                        android:textAllCaps="false"
                        android:textColor="@color/fg"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Heading compass card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="HEADING"
                android:textColor="@color/fg_faint"
                android:textSize="10sp" />

            <com.rishabh.astranav.home.HomeHeadingCompassView
                android:id="@+id/homeCompass"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/compassReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="N · 000°"
                android:textColor="@color/fg_dim"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Last trip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.1"
            android:text="LAST TRIP"
            android:textColor="@color/fg_faint"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/lastTripCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <LinearLayout
                    style="@style/HomeTripStatCell"
                    android:layout_row="0"
                    android:layout_column="0">

                    <FrameLayout style="@style/HomeTripIconBg">

                        <ImageView
                            style="@style/HomeTripIcon"
                            android:src="@drawable/ic_route" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeTripLabel"
                            android:text="Distance" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="18.6 km"
                            android:textColor="@color/fg"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeTripStatCell"
                    android:layout_row="0"
                    android:layout_column="1">

                    <FrameLayout style="@style/HomeTripIconBg">

                        <ImageView
                            style="@style/HomeTripIcon"
                            android:src="@drawable/ic_clock" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeTripLabel"
                            android:text="Duration" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="27 min"
                            android:textColor="@color/fg"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeTripStatCell"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_marginTop="14dp">

                    <FrameLayout style="@style/HomeTripIconBg">

                        <ImageView
                            style="@style/HomeTripIcon"
                            android:src="@drawable/ic_gauge" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeTripLabel"
                            android:text="Max speed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="76 km/h"
                            android:textColor="@color/fg"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/HomeTripStatCell"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_marginTop="14dp">

                    <FrameLayout style="@style/HomeTripIconBg">

                        <ImageView
                            style="@style/HomeTripIcon"
                            android:src="@drawable/ic_ruler" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeTripLabel"
                            android:text="Est. accuracy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="±6 m"
                            android:textColor="@color/fg"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View analysis"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_right"
                    app2:tint="@color/cyan" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
