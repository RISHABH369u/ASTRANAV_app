<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/screen_kicker"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ASTRA NAV" />

    <TextView
        android:id="@+id/screen_title"
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Screen title" />

    <TextView
        android:id="@+id/screen_subtitle"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Screen subtitle" />

    <LinearLayout
        android:id="@+id/content_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <Button
        android:id="@+id/action_primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_primary"
        android:text="CONTINUE"
        android:textColor="#04211F"
        android:textStyle="bold" />
</LinearLayout>
