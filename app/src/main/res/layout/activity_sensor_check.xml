<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <TextView
            android:id="@+id/kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="ASTRA NAV"
            android:textColor="@color/fg_faint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.03"
            android:text="SENSOR CHECK"
            android:textColor="@color/fg"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Verifying motion sensors before navigation"
            android:textColor="@color/fg_dim"
            android:textSize="12.5sp" />

        <!-- Phone scan visualization -->
        <com.rishabh.astranav.sensorcheck.ui.view.PhoneScanView
            android:id="@+id/phoneScan"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <!-- Sensor rows -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sensorList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Summary strip -->
        <LinearLayout
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_summary_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ProgressBar
                    android:id="@+id/summarySpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/cyan" />

                <com.rishabh.astranav.sensorcheck.ui.view.StatusDotView
                    android:id="@+id/summaryDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Checking sensors…"
                android:textColor="@color/fg_dim"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.5"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnContinue"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_primary_button"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_chevron_right"
                android:gravity="center"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDiagnostics"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_info"
                android:gravity="center"
                android:text="View diagnostics"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
