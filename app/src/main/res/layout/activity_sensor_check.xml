<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sensorCheckRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="SYSTEM CHECK"
            android:textColor="@color/astra_text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Verifying onboard sensors for navigation"
            android:textColor="@color/astra_text_secondary"
            android:textSize="12sp" />

        <!-- Rows are inflated here at runtime, one per sensor -->
        <LinearLayout
            android:id="@+id/sensorList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:alpha="0"
            android:gravity="center"
            android:textColor="@color/astra_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:alpha="0"
            android:background="@drawable/bg_continue_button"
            android:elevation="0dp"
            android:letterSpacing="0.1"
            android:text="CONTINUE"
            android:textColor="@color/astra_background"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
