<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="28dp">

    <!-- Warning icon -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_warn_icon_circle">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_compass"
            app:tint="@color/warn" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:gravity="center"
        android:text="⚠  MOUNTING ORIENTATION CHANGED"
        android:textColor="@color/fg"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="The device appears to sit differently than when it was last calibrated. Recalibrating keeps dead-reckoning accurate through GNSS outages."
        android:textColor="@color/fg_dim"
        android:textSize="13sp"
        android:maxWidth="290dp" />

    <!-- Offset comparison card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Saved offset"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/savedOffsetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detected offset"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/detectedOffsetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/warn"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_default"
            android:padding="10dp"
            android:text="Continuing without recalibration reduces position confidence during long outages."
            android:textColor="@color/fg_dim"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Actions -->
    <Button
        android:id="@+id/btnRecalibrateNow"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_primary_button"
        android:gravity="center"
        android:text="Recalibrate Now"
        android:textAllCaps="false"
        android:textColor="@color/button_primary_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnContinueAnyway"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_secondary_button"
        android:gravity="center"
        android:text="Continue Anyway"
        android:textAllCaps="false"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
