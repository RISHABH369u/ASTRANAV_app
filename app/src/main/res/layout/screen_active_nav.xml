<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_850">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:text="MAP / ROUTE SIMULATION"
        android:textColor="@color/fg_faint"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_surface"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AstraLabel"
            android:text="Current speed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48 km/h"
            android:textColor="@color/fg"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heading   042°     Accuracy   ±1.8 m"
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
