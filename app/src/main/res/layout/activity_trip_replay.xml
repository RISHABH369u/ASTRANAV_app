<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fitsSystemWindows="true">

    <com.mapbox.maps.MapView
        android:id="@+id/replayMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Trip Replay"
                android:textColor="@color/fg"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot_warn" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEMO PLAYBACK · sample data, not a recorded trip"
                    android:textColor="@color/warn"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseReplay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_map_pill_button"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/fg_dim" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status pill -->
    <LinearLayout
        android:id="@+id/replayStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_map_pill_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp">

        <View
            android:id="@+id/replayStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/dot_good" />

        <TextView
            android:id="@+id/replayStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="GNSS + INS"
            android:textColor="@color/fg"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mode toggle -->
    <LinearLayout
        android:id="@+id/replayModeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="116dp"
        android:background="@drawable/bg_map_pill_button"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/modeGnss"
            style="@style/ReplayModeButton"
            android:text="GNSS" />

        <TextView
            android:id="@+id/modeRaw"
            style="@style/ReplayModeButton"
            android:text="Raw INS" />

        <TextView
            android:id="@+id/modeHybrid"
            style="@style/ReplayModeButton"
            android:text="Hybrid" />
    </LinearLayout>

    <!-- Bottom control deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_map_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="22dp">

        <!-- Telemetry strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginEnd="4dp">

                <TextView
                    style="@style/MapTelemetryLabel"
                    android:text="SPEED" />

                <TextView
                    android:id="@+id/replaySpeedValue"
                    style="@style/MapTelemetryValue"
                    android:text="0 km/h" />
            </LinearLayout>

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginHorizontal="4dp">

                <TextView
                    style="@style/MapTelemetryLabel"
                    android:text="HEADING" />

                <TextView
                    android:id="@+id/replayHeadingValue"
                    style="@style/MapTelemetryValue"
                    android:text="N · 000°" />
            </LinearLayout>

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginStart="4dp">

                <TextView
                    style="@style/MapTelemetryLabel"
                    android:text="ACCURACY" />

                <TextView
                    android:id="@+id/replayAccuracyValue"
                    style="@style/MapTelemetryValue"
                    android:text="± -- m" />
            </LinearLayout>
        </LinearLayout>

        <!-- Event chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/eventChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Timeline -->
        <SeekBar
            android:id="@+id/replaySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressTint="@color/cyan"
            android:thumbTint="@color/cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/replayTimeElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="@color/fg_faint"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/replayTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="01:18"
                android:textColor="@color/fg_faint"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnPrevEvent"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="26dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="@color/fg_dim" />

            <FrameLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_primary_button">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/playPauseIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/button_primary_text" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnNextEvent"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="26dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/fg_dim" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
