<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fitsSystemWindows="true">


    <!-- ===================================================== -->
    <!-- MAP -->
    <!-- ===================================================== -->

    <com.mapbox.maps.MapView
        android:id="@+id/replayMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- ===================================================== -->
    <!-- TOP GRADIENT / DARKENING -->
    <!-- ===================================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_replay_top_gradient" />


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="ASTRANAV"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="IO-VNBD  /  NAVIGATION REPLAY"
                android:textColor="@color/fg_dim"
                android:textSize="9sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot_cyan" />


                <TextView
                    android:id="@+id/tvDatasetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAD IO-VNBD S-CSV"
                    android:textColor="@color/cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />


            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">


            <TextView
                android:id="@+id/tvDatasetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxWidth="150dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="NO DATASET"
                android:textColor="@color/fg"
                android:textSize="10sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvHz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="10 Hz"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:textStyle="bold" />


        </LinearLayout>


        <FrameLayout
            android:id="@+id/btnCloseReplay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_map_pill_button"
            android:clickable="true"
            android:focusable="true">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/fg_dim"
                android:textSize="25sp" />

        </FrameLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CENTER STATUS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/replayStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="94dp"
        android:background="@drawable/bg_map_pill_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/cyan"
            android:textSize="8sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="ASTRANAV CORE"
            android:textColor="@color/fg"
            android:textSize="10sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- ===================================================== -->
    <!-- BOTTOM CONTROL DECK -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_map_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">


        <!-- ================================================= -->
        <!-- DATASET / LOAD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATASET"
                    android:textColor="@color/fg_faint"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvDatasetNameBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="IO-VNBD"
                    android:textColor="@color/fg"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <TextView
                android:id="@+id/btnLoadPhone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_map_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="12dp"
                android:text="S-CSV"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/btnLoadVehicle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_map_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="12dp"
                android:text="V-CSV"
                android:textColor="@color/fg_dim"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PRIMARY TELEMETRY -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:textColor="@color/fg_faint"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEADING"
                    android:textColor="@color/fg_faint"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POS ERROR"
                    android:textColor="@color/fg_faint"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvPositionError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HDG ERROR"
                    android:textColor="@color/fg_faint"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvHeadingError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- METRICS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_map_pill_button"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RMSE"
                    android:textColor="@color/fg_faint"
                    android:textSize="7sp" />


                <TextView
                    android:id="@+id/tvRmse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="95% ERROR"
                    android:textColor="@color/fg_faint"
                    android:textSize="7sp" />


                <TextView
                    android:id="@+id/tvP95"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FINAL"
                    android:textColor="@color/fg_faint"
                    android:textSize="7sp" />


                <TextView
                    android:id="@+id/tvFinalError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED MAE"
                    android:textColor="@color/fg_faint"
                    android:textSize="7sp" />


                <TextView
                    android:id="@+id/tvSpeedMae"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textColor="@color/fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HEALTH CHIPS -->
        <!-- ================================================= -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:scrollbars="none">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/chipSensor"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="SENSOR  —" />


                <TextView
                    android:id="@+id/chipRate"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="10 Hz  —" />


                <TextView
                    android:id="@+id/chipEskf"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="ESKF  —" />


                <TextView
                    android:id="@+id/chipNhc"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="NHC  —" />


                <TextView
                    android:id="@+id/chipZupt"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="ZUPT  —" />


                <TextView
                    android:id="@+id/chipZaru"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:text="ZARU  —" />


                <TextView
                    android:id="@+id/chipDvfc"
                    style="@style/ReplayModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="DVFC  —" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- ================================================= -->
        <!-- TIMELINE -->
        <!-- ================================================= -->

        <SeekBar
            android:id="@+id/replaySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressTint="@color/cyan"
            android:thumbTint="@color/cyan" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvTimeElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="@color/fg_faint"
                android:textSize="9sp" />


            <TextView
                android:id="@+id/tvTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="@color/fg_faint"
                android:textSize="9sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TRANSPORT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="−5s"
                android:textColor="@color/fg_dim"
                android:textSize="10sp"
                android:textStyle="bold" />


            <FrameLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:id="@+id/tvPlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/button_primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>


            <TextView
                android:id="@+id/btnForward"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="+5s"
                android:textColor="@color/fg_dim"
                android:textSize="10sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="50dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_map_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1×"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvPlaybackSpeed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="1×" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>