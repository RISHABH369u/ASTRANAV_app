<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_horizontal"
        android:paddingTop="28dp"
        android:paddingRight="@dimen/screen_horizontal"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_surface"
                android:contentDescription="Back"
                android:rotation="180"
                android:src="@drawable/ic_navigate" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.28"
                android:text="ASTRA NAV"
                android:textColor="@color/fg_faint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_surface"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="2 / 3"
                android:textColor="@color/fg"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alignment_title"
            android:textColor="@color/fg"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alignment_subtitle"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_selected"
                android:contentDescription="Alignment"
                android:padding="9dp"
                android:src="@drawable/ic_compass" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/alignment_instruction"
                android:textColor="@color/fg_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/why_alignment"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="@string/why_alignment"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/view_3d"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selected"
                android:text="@string/three_d_view"
                android:textAllCaps="false"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <Button
                android:id="@+id/view_top"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:text="@string/top_view"
                android:textAllCaps="false"
                android:textColor="@color/fg_dim"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/alignment_scene_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_scene">

            <com.astranav.ui.CalibrationSceneView
                android:id="@+id/calibration_scene"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="@string/drag_phone"
                android:textColor="@color/fg_faint"
                android:textSize="10sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●  Y  Up"
                android:textColor="@color/good"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●  X  Right"
                android:textColor="@color/crit"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●  Z  Forward"
                android:textColor="@color/blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/AstraLabel"
                    android:text="Alignment" />

                <TextView
                    android:id="@+id/alignment_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="64%"
                    android:textColor="@color/fg"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/alignment_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:progress="64"
                    android:progressDrawable="@drawable/progress_alignment" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/AstraLabel"
                    android:text="Angular diff." />

                <TextView
                    android:id="@+id/angular_diff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="22.8°"
                    android:textColor="@color/cyan"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Target &lt; 5°"
                    android:textColor="@color/fg_faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/rotate_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selected"
                android:text="@string/rotate"
                android:textAllCaps="false"
                android:textColor="@color/cyan" />

            <Button
                android:id="@+id/nudge_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:text="@string/nudge"
                android:textAllCaps="false"
                android:textColor="@color/fg_dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:gravity="center"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/yaw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="90"
                android:progress="23" />

            <SeekBar
                android:id="@+id/pitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="90"
                android:progress="53" />

            <SeekBar
                android:id="@+id/roll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="90"
                android:progress="40" />
        </LinearLayout>

        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface_2"
            android:text="@string/reset_view"
            android:textAllCaps="false"
            android:textColor="@color/fg_dim"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="14dp">

            <TextView
                android:id="@+id/alignment_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rotate to align"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Match the device to the vehicle’s forward axis."
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:alpha="0.4"
            android:background="@drawable/bg_primary"
            android:enabled="false"
            android:text="@string/adjust_phone"
            android:textAllCaps="false"
            android:textColor="#04211F"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
