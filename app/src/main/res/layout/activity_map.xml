<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:fitsSystemWindows="true">

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_map_pill_button"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/fg_dim" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navModePill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_map_pill_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="11dp">

            <View
                android:id="@+id/navModeDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_good" />

            <TextView
                android:id="@+id/navModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="GNSS + INS"
                android:textColor="@color/fg"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnIntegrity"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_map_pill_button"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/integrityDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="center"
                android:background="@drawable/dot_good" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dead-reckoning banner -->
    <LinearLayout
        android:id="@+id/drBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="66dp"
        android:background="@drawable/bg_dr_banner"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/dot_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-medium"
                android:letterSpacing="0.03"
                android:text="DEAD RECKONING ACTIVE"
                android:textColor="@color/cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="GNSS unavailable. Navigation continues using IMU + AI + vehicle constraints."
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Map controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="270dp"
        android:orientation="vertical"
        app:layout_anchor="@id/mapView"
        app:layout_anchorGravity="bottom|end">

        <FrameLayout
            android:id="@+id/btnRecenter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_map_pill_button"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_compass"
                android:tint="@color/cyan" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom sheet -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_map_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="238dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Primary telemetry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="CURRENT SPEED"
                    android:textColor="@color/fg_faint"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mapSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-medium"
                        android:text="0"
                        android:textColor="@color/fg"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="8dp"
                        android:text="km/h"
                        android:textColor="@color/fg_dim"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ACCURACY"
                    android:textColor="@color/fg_faint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/mapAccuracyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="± -- m"
                    android:textColor="@color/good"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Heading / Trip / GNSS row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginEnd="4dp">

                <TextView
                    style="@style/MapTelemetryLabel"
                    android:text="HEADING" />

                <TextView
                    android:id="@+id/mapHeadingValue"
                    style="@style/MapTelemetryValue"
                    android:text="N · 000°" />
            </LinearLayout>

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:id="@+id/mapThirdCellLabel"
                    style="@style/MapTelemetryLabel"
                    android:text="TRIP DIST." />

                <TextView
                    android:id="@+id/mapThirdCellValue"
                    style="@style/MapTelemetryValue"
                    android:text="0.0 km" />
            </LinearLayout>

            <LinearLayout
                style="@style/MapTelemetryCell"
                android:layout_marginStart="4dp">

                <TextView
                    style="@style/MapTelemetryLabel"
                    android:text="GNSS" />

                <TextView
                    android:id="@+id/mapGnssValue"
                    style="@style/MapTelemetryValue"
                    android:text="FIX" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expanded diagnostics (visible once dragged up) -->
        <LinearLayout
            android:id="@+id/diagnosticsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline_soft" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.1"
                android:text="NAVIGATION INTEGRITY"
                android:textColor="@color/fg_faint"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/integrityRowDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_good" />

                <TextView
                    android:id="@+id/integrityRowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="STABLE"
                    android:textColor="@color/good"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/integrityScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--%"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.1"
                android:text="SUBSYSTEMS"
                android:textColor="@color/fg_faint"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowEskf"
                    layout="@layout/row_diagnostic_stub" />

                <include
                    android:id="@+id/rowAi"
                    layout="@layout/row_diagnostic_stub" />

                <include
                    android:id="@+id/rowMapMatch"
                    layout="@layout/row_diagnostic_stub" />

                <include
                    android:id="@+id/rowZupt"
                    layout="@layout/row_diagnostic_stub" />

                <include
                    android:id="@+id/rowZaru"
                    layout="@layout/row_diagnostic_stub" />

                <include
                    android:id="@+id/rowDvfc"
                    layout="@layout/row_diagnostic_stub" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:text="V7 Supreme MoE / GRU speed router aren't part of this codebase yet — not shown here rather than faked."
                android:textColor="@color/fg_faint"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
