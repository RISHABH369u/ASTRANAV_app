<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#996C8CFF" />
        </shape>
    </item>

    <!-- Faint tick marks feel would normally be a custom draw; a soft
         secondary ring stands in cheaply and still reads as instrumentation -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <stroke
                android:width="0.6dp"
                android:color="#336C8CFF" />
        </shape>
    </item>

</layer-list>