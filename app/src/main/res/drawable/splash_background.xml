<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base diagonal gradient: deep space navy to near-black -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#0F1B2E"
                android:centerColor="#0A1220"
                android:endColor="#05070C" />
        </shape>
    </item>

    <!-- Vignette to pull focus toward center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:startColor="#00000000"
                android:endColor="#66000000" />
        </shape>
    </item>

</layer-list>